{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
