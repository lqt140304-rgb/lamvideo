{
  "id": "Mua100C08",
  "slug": "mua-100-c08",
  "topic": "Chuyện gì xảy ra nếu mưa liên tục 100 ngày? Cảnh 8: Những tuần sau, đêm gió đổi giọng",
  "title": [
    "Những tuần sau",
    "Đêm gió đổi giọng"
  ],
  "voice": {
    "id": "HXqqNj3PDxRdHVH1pXog",
    "model": "eleven_v4",
    "lang": "vi"
  },
  "gaps": {
