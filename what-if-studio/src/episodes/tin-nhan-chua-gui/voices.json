 "auditions": {
  "narrator": {
   "line": "Ông Lộc nhìn lên qua cặp kính cũ. Ngọn đèn vàng chỉ soi rõ một nửa mặt ông.",
   "voices": [
    {
     "name": "Trung Le Quoc v4 (giong chu repo)",
     "id": "HXqqNj3PDxRdHVH1pXog"
    },
    {
     "name": "Thanh nu Sai Gon",
     "id": "N0Z0aL8qHhzwUHwRBcVo"
    },
    {
     "name": "Quang Toan nam mien Nam",
     "id": "ZsjEJaLQy3sgvwxicmDx"
    }
   ]
  },
  "loc": {
   "line": "[coldly] Mày nghĩ với số tiền đó, mày sửa nổi cái điện thoại cũ rích của mày à?",
   "voices": [
    {
     "name": "Thanh lon tuoi mien Nam",
     "id": "oLR5l8TbWm0sNc5LspDA"
    },
    {
     "name": "Hung mien Nam",
     "id": "DTLhW2kDOWq9IAPipCcu"
    }
   ]
  },
  "duy": {
   "line": "Bữa đó anh sợ bố nghe thấy em khóc rồi lại đánh. Anh cuống quá nên mới quát em.",
   "voices": [
    {
     "name": "Trung Le Quoc v4 (giong chu repo)",
     "id": "HXqqNj3PDxRdHVH1pXog"
    },
    {
     "name": "Duc Huy",
     "id": "w2KTJ6MO4SIK6nWK4YH8"
    },
    {
     "name": "Trieu Duong",
     "id": "UsgbMVmY3U59ijwK5mdh"
    }
   ]
  },
  "thao": {
   "line": "Mẹ ơi, chỗ này lại bung rồi nè. Mẹ vá cho con nữa nha.",
   "voices": [
    {
     "name": "Cam Hong",
     "id": "x4KAhuXs2G8TfK9Zr7Q4"
    },
    {
     "name": "Tam Nguyen tre em",
     "id": "IovBBFnLZ6QzJhFLLroy"
    }
   ]
  },
  "me": {
   "line": "[gentle] Con là anh của em, nhưng vẫn là con của mẹ mà. Con đừng chịu một mình.",
   "voices": [
    {
     "name": "Lam Vy",
     "id": "BfchfKCM67ImGdaJ1smU"
    },
    {
     "name": "Thanh Ngoc",
     "id": "Na15FlRRkMEDtEW4nVVP"
    }
   ]
  }
 },
