  "tail": 2.0,
  "science": [
    {
      "claim": "Giả định hư cấu. Mưa tạnh nhưng nước từ thượng nguồn chưa chảy qua hết: mực nước ở trạm thượng nguồn và ở mốc hẻm vẫn tăng; sân trường (+2,0 m) còn khô, bậc thấp nhất của lối xuống đường đã chìm. Không khẳng định mọi sông đạt đỉnh ngay khi mưa tạnh."
    }
  ],
  "script": [
    {
      "beat": "p1",
      "text": "[thoughtful] Trạm thượng nguồn vừa gửi số đo mới. Nước tại đó vẫn đang dâng. Dưới thị trấn, vạch đo ở đầu hẻm lại tăng. Gần trường, bậc thấp nhất của lối xuống đường đã chìm; bậc phía trên bắt đầu ướt. Sân trường còn khô, nhưng đường ra đang thu hẹp."
    },
    {
      "beat": "p2",
      "text": "Trời đã ngừng mưa. Nhưng phần nước từ xa chưa chảy qua hết nơi họ ở."
    },
    {
      "beat": "p3",
      "text": "Linh nhìn chiếc áo trên tay, rồi nhìn bố. [worried] “Nhưng tạnh rồi mà. Sao mình còn phải đi chỗ khác?”"
    },
    {
      "beat": "p4",
      "text": "An cúi xuống ngang tầm mắt con. [warmly] “Tại vì nước trên núi vẫn đang về, như hôm bố chỉ trên bản đồ ấy. Sân mình còn khô, nhưng đường thấp có thể bị ngập. Mình đi lúc đường còn dùng được sẽ đỡ nguy hiểm hơn.”"
    },
    {
      "beat": "p5",
      "text": "[worried] “Bố đi với con chứ?”"
    },
    {
      "beat": "p6",
      "text": "[reassuring] “Mẹ đưa con sang trước. Bố phải giúp chuyển máy cấp nước, nên bố đi sau một chút. Tới nơi, con ngồi cùng mẹ ở trong nhà nhé. Xong việc bố sẽ tới chỗ hai mẹ con.”"
    },
    {
      "beat": "p7",
      "text": "Linh siết tay anh. [softly] “Bố nhớ nói với mẹ nếu bố phải đổi chỗ.”"
    },
    {
      "beat": "p8",
      "text": "[warmly] “Ừ. Bố mang bộ đàm, bố sẽ nhờ báo cho mẹ.”"
    },
    {
      "beat": "p9",
      "text": "[thoughtful] Cô nhớ ngón tay anh đã chỉ dọc con sông vào ngày thứ bảy."
    },
    {
      "beat": "p10",
      "text": "Suốt những ngày chờ đợi, cô chỉ mong không còn nghe mưa trên mái. Giờ mái nhà đã yên, mà dòng sông vẫn đang mang nước về."
    }
  ],
