   "lines": [
    {
     "id": "S04_MINH_01",
     "who": "MINH",
     "text": "Tuần này bận à?"
    },
    {
     "id": "S04_TEO_01",
     "who": "TEO",
     "text": "Cũng không đến mức đấy.",
     "pose": "sad"
    },
    {
     "id": "S04_TEO_02",
     "who": "TEO",
     "text": "Có hôm tao dậy rồi. Mặc áo rồi… cuối cùng vẫn ngồi lại.",
     "gap": 0.9,
     "pose": "sad"
    },
    {
     "id": "S04_MINH_02",
     "who": "MINH",
     "text": "Vì sao?",
     "pose": "think"
    },
    {
     "id": "S04_TEO_03",
     "who": "TEO",
     "text": "Tao cũng không biết. Cứ nghĩ ra đấy ai cũng chạy ngon lành. Còn tao mới tí đã mệt.",
     "pose": "think"
    },
    {
     "id": "S04_MINH_03",
     "who": "MINH",
     "text": "Mày mới mua giày. Có đăng ký thi với ai đâu.",
     "pose": "stand"
    },
    {
     "id": "S04_TEO_04",
     "who": "TEO",
     "text": "Lúc bấm mua, tao tưởng tượng được hết. Sáng dậy sớm này, chạy xong về này… thấy mình khác hẳn.",
     "gap": 1.1,
     "pose": "sad"
    },
    {
     "id": "S04_TEO_05",
     "who": "TEO",
     "text": "Xong đồ về rồi… tao vẫn là tao.",
     "gap": 0.9,
     "pose": "sad"
    },
    {
     "id": "S04_MINH_04",
     "who": "MINH",
     "text": "Tối nay mày có việc gì không?",
     "gap": 2.2,
     "pose": "think"
    },
    {
     "id": "S04_TEO_06",
     "who": "TEO",
     "text": "Không. Sao?",
